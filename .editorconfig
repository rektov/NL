root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,h,hpp,c,cc,cxx}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,md,py}]
indent_size = 2

[*.vcxproj]
indent_style = space
indent_size = 2
end_of_line = crlf

[CMakeLists.txt]
indent_size = 2
